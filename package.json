{
  "name": "charmzy-storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "cf:dev": "npm run build && node ./node_modules/wrangler/bin/wrangler.js dev",
    "cf:deploy": "npm run build && node ./node_modules/wrangler/bin/wrangler.js deploy",
    "cf:dry-run": "npm run build && node ./node_modules/wrangler/bin/wrangler.js deploy --dry-run",
    "cf:migrate:local": "node ./node_modules/wrangler/bin/wrangler.js d1 migrations apply charmzy_db --local",
    "cf:migrate:remote": "node ./node_modules/wrangler/bin/wrangler.js d1 migrations apply charmzy_db --remote",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  }
}
